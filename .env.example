# Copy this file to .env and fill in the keys for whichever model(s) you want to use.
# Both are optional independently -- the app disables a model in the UI if its key is missing.

# Anthropic API key -- https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Google AI Studio API key -- https://aistudio.google.com/apikey
GOOGLE_API_KEY=

# Optional -- port the Flask dev server runs on (default 5000)
PORT=5000
